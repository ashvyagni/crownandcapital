# Set these in your shell or deployment environment for the Node room server.
# No database, API key or account password is required. This file is a reference;
# the server does not automatically read .env files.
HOST=127.0.0.1
PORT=2567
DATA_DIR=.data/rooms
# Comma-separated browser origins, only needed for deliberate cross-origin use.
ALLOWED_ORIGINS=
# Vite dev proxy target. Browser and production clients default to same-origin /ws.
CROWN_SERVER_URL=ws://127.0.0.1:2567
# Optional browser endpoint, set before build only for a separate backend origin.
# VITE_WS_URL=wss://your-game.example/ws
